# Cấu hình backend LibAssist — chép file này thành `.env` rồi điền.
# `.env` đã được gitignore; đừng commit mật khẩu.

# Chạy trên PostgreSQL hay SQL Server. Cùng một schema, cùng một bộ query —
# đổi biến này là đổi database, không phải đổi code.
DB_DIALECT=postgres

PORT=3001

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Dùng khi DB_DIALECT=postgres
DATABASE_URL=postgres://localhost:5432/libassist

# ── SQL Server ────────────────────────────────────────────────────────────────
# Dùng khi DB_DIALECT=mssql. tedious nhận từng trường rời, không nhận URL.
MSSQL_HOST=localhost
MSSQL_PORT=1433
# Bản SQL Server Express cài mặc định là instance có tên (localhost\SQLEXPRESS) và dùng
# cổng động chứ không phải 1433 — khi đó bỏ trống MSSQL_PORT và điền dòng dưới:
# MSSQL_INSTANCE=SQLEXPRESS
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_DATABASE=libassist
# Bản cài SQL Server nội bộ thường dùng chứng chỉ tự ký.
MSSQL_TRUST_CERT=true
